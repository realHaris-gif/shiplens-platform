# Application Port and Node Environment
PORT=3000
NODE_ENV=development

# Database Connection Details
DB_HOST=localhost
DB_PORT=5432
DB_USER=shiplens_user
DB_PASSWORD=your_secure_db_password_here
DB_NAME=shiplens_db
DATABASE_URL=postgresql://shiplens_user:your_secure_db_password_here@localhost:5432/shiplens_db

# SSL Configuration (set "true" for Render / Cloud Postgres, "false" for local Docker Compose)
DB_SSL=false

# Authentication Secret (Must be >= 32 characters in production)
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_32_chars

# Optional Database Seeding Password
SEED_PASSWORD=Password123!